{
  "enabled": true,
  "name": "TypeScript Error Check",
  "description": "Checks for TypeScript compile errors after saving any TS/TSX file and reports issues.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.ts",
      "**/*.tsx"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Check the TypeScript diagnostics for the edited file and report any errors. If there are errors, explain what's wrong and suggest a fix."
  }
}