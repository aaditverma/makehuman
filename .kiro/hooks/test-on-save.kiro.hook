{
  "enabled": true,
  "name": "Run Tests on Save",
  "description": "Automatically runs the vitest test suite when any TypeScript or TSX file is saved, catching regressions immediately.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.ts",
      "**/*.tsx"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npx vitest run --reporter=verbose 2>&1",
    "timeout": 30
  }
}